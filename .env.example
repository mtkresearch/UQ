# Copy this file to .env and fill in your local paths.
# .env is never committed.

# HuggingFace token (required for gated models)
export HUGGING_FACE_HUB_TOKEN="your_hf_token_here"

# OpenAI key (optional, only for long-form generation experiments)
# export OPENAI_API_KEY="your_openai_key_here"

# Wandb (optional)
# export WANDB_API_KEY="your_wandb_key_here"

# Root directory for all experiment outputs (scratch space)
export SEP_SCRATCH="/your/scratch/path"

# Directory where HuggingFace model weights are stored
export SEP_MODELS_DIR="/your/models/path"

# Python executable (conda env or venv)
export SEP_PYTHON="python"
